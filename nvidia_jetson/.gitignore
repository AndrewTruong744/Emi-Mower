# Ignore local ROS workspace build directories
**/ros_ws/build/
**/ros_ws/install/
**/ros_ws/log/
# Generated by ament_cargo; contains machine-specific ROS paths.
**/ros_ws/.cargo/

# Ignore Cargo build output from Rust ROS packages.
**/target/

# Ignore local editor caching data
.vscode/

# Ignore Python compiler caches
__pycache__/
*.pyc

.venv

.env
.key
.sim/
