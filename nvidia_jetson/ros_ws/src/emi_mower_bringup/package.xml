<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emi_mower_bringup</name>
  <version>0.1.0</version>
  <description>Launch configuration for the Emi Mower ROS 2 stack.</description>
  <maintainer email="andrewtruong40024@gmail.com">Andrew Truong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- These drivers are absent from the simulator image.  Their launch path
       is available only in images built with BUILD_PHYSICAL_DRIVERS=1. -->
  <exec_depend condition="$BUILD_PHYSICAL_DRIVERS == 1">depthai_ros_driver</exec_depend>
  <exec_depend>emi_mower_control</exec_depend>
  <exec_depend>emi_mower_zenoh_gateway</exec_depend>
  <exec_depend>emi_mower_livekit</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rmw_zenoh_cpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend condition="$BUILD_PHYSICAL_DRIVERS == 1">sllidar_ros2</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
