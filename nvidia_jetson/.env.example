# Copy this file to .env for development. Trusted provisioning overwrites .env
# on the Jetson with the mower's UUID and production router endpoint.
MOWER_ID=00000000-0000-4000-8000-000000000001
MOWER_CERT_DIR=./certs
ZENOH_ROUTER_ENDPOINT=tls/host.docker.internal:7448
ZENOH_VERIFY_NAME_ON_CONNECT=false
ZENOH_BOOTSTRAP_ENDPOINT=tls/host.docker.internal:7449
ZENOH_BOOTSTRAP_VERIFY_NAME_ON_CONNECT=false
MOWER_LAUNCH=sim
STM32_CAN_INTERFACE=can0
RPLIDAR_DEVICE=/dev/rplidar
