{
  "mode": "router",

  "listen": {
    "endpoints": [
      "tls/0.0.0.0:7448" // Private mTLS listener for FastAPI & Router B
    ]
  },

  "transport": {
    "link": {
      "tls": {
        "root_ca_certificate": "/run/emi-mower/identity/root_ca.pem",
        "listen_certificate": "/run/emi-mower/identity/current/router.crt",
        "listen_private_key": "/run/emi-mower/identity/current/router.key",
        "enable_mtls": true // Forces client X.509 cert validation
      }
    }
  },

  // 1. Enable Write Access to Admin Space
  adminspace: {
    permissions: {
      read: true,
      write: true  // Required to accept runtime PUTs to @/config/...
    }
  },

  "plugins": {
    "rest": {
      "http_port": "127.0.0.1:8002"
    }
  },

  "access_control": {
    "enabled": true,
    "default_permission": "deny",

    "rules": [
      {
        "id": "full_access",
        "permission": "allow",
        "flows": ["ingress", "egress"],
        "messages": [
          "put",
          "declare_subscriber",
          "declare_liveliness_subscriber",
          "liveliness_token",
          "declare_queryable",
          "query",
          "reply",
          "delete"
        ],
        "key_exprs": ["**"]
      }
    ],

    "subjects": [
      {
        "id": "fastapi_admin",
        "cert_common_names": ["Emi Mower Backend"]
      },
      {
        "id": "router_b_peer",
        "cert_common_names": ["Emi Mower Zenoh App"] // Cert used by Router B to link
      }
    ],

    "policies": [
      {
        "id": "internal_mesh_policy",
        "subjects": ["fastapi_admin", "router_b_peer"],
        "rules": ["full_access"]
      }
    ]
  }
}
