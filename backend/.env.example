# Settings are the authoritative source for local-safe defaults. Leave an
# optional value blank to use its Settings default; do not copy defaults here.

# Database (PostgreSQL) overrides
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# Valkey (Redis-compatible) Configuration
VALKEY_HOST=
VALKEY_PORT=
VALKEY_PASSWORD=

# Required: the backend refuses to start without a non-empty value.
JWT_SECRET=

# Google Cloud Storage / Firebase Admin use Application Default Credentials.
GCP_PROJECT_ID=
GCS_CUTOUT_BUCKET=
GCS_UPLOAD_URL_TTL_SECONDS=
GCS_DOWNLOAD_URL_TTL_SECONDS=

# Docker Compose-only host path; Settings does not read this value. It is used
# only by local-docker-compose.gcs.yml to mount the host ADC file read-only.
GOOGLE_ADC_FILE=
# Optional legacy JSON-key fallback; prefer ADC.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Set to true only for local tests that intentionally bypass Firebase.
FIREBASE_DISABLED=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Zenoh Configuration
ZENOH_APP_REST_URL=
ZENOH_MTLS_ENDPOINT=
ZENOH_MTLS_REST_URL=
ZENOH_BOOTSTRAP_ENDPOINT=
ZENOH_BOOTSTRAP_VERIFY_NAME=
ZENOH_CA_CERT=
ZENOH_FASTAPI_CERT=
ZENOH_FASTAPI_KEY=
STEP_CA_URL=
STEP_CA_PROVISIONER_PASSWORD_FILE=
