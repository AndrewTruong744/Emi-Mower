# Database (PostgreSQL) Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# Valkey (Redis-compatible) Configuration
VALKEY_HOST=
VALKEY_PORT=
VALKEY_DB=
VALKEY_PASSWORD=

# JWT Configuration
JWT_SECRET=

# Google Cloud Storage / Firebase Admin use Application Default Credentials.
GCP_PROJECT_ID=emi-mower
GCS_CUTOUT_BUCKET=emi-mower-cutouts-sandbox
# Host path consumed by local-docker-compose.gcs.yml; do not commit credentials.
GOOGLE_ADC_FILE=
# Optional legacy JSON-key fallback; prefer ADC.
FIREBASE_SERVICE_ACCOUNT_PATH=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Zenoh Configuration
ZENOH_APP_REST_URL=http://127.0.0.1:8001
ZENOH_MTLS_REST_URL=http://127.0.0.1:8002
ZENOH_CA_CERT=certs/ca/ca.crt
ZENOH_FASTAPI_CERT=certs/fastapi/server.crt
ZENOH_FASTAPI_KEY=certs/fastapi/server.key
