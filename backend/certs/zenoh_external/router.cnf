[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = US
O = EmiSamaTechnologies
CN = Emi Mower Zenoh External

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = localhost.localdomain
DNS.3 = my-dev-pc.local
IP.1 = 127.0.0.1
IP.2 = ::1
IP.3 = 192.168.1.73