{
  "mode": "router",

  "listen": {
    "endpoints": [
      "ws/0.0.0.0:7447" // Local, non-TLS Zenoh endpoint for client apps
    ]
  },

  // Establishes persistent router-to-router link to Router A
  "connect": {
    "endpoints": [
      "tls/127.0.0.1:7448"
    ]
  },

  "transport": {
    "auth": {
      "usrpwd": {
        "dictionary_file": "zenoh-router-users.txt"
      }
    },
    "link": {
      "tls": {
        "root_ca_certificate": "/run/emi-mower/identity/root_ca.pem",
        // Client certs used by Router B to authenticate to Router A on port 7448
        "connect_certificate": "/run/emi-mower/identity/current/router.crt",
        "connect_private_key": "/run/emi-mower/identity/current/router.key",
        
        "listen_certificate": "/run/emi-mower/identity/current/router.crt",
        "listen_private_key": "/run/emi-mower/identity/current/router.key",
        "enable_mtls": true
      }
    },
    // Credentials are added dynamically through the admin REST API.
  },

  // 1. Enable Write Access to Admin Space
  adminspace: {
    permissions: {
      read: true,
      write: true  // Required to accept runtime PUTs to @/config/...
    }
  },

  "plugins": {
    // WebSocket endpoint used by @eclipse-zenoh/zenoh-ts.
    "remote_api": {
      "websocket_port": "10000"
    },
    "rest": {
      "http_port": "127.0.0.1:8001"
    }
  },

  "access_control": {
    "enabled": true,
    "default_permission": "deny", // Only explicitly listed application keys are reachable

    "rules": [
      {
        "id": "user_login_query",
        "permission": "allow",
        "flows": ["ingress", "egress"],
        "messages": ["query", "reply"],
        "key_exprs": ["user/login"]
      },
      {
        "id": "internal_queryable_declaration",
        "permission": "allow",
        "flows": ["ingress", "egress"],
        "messages": ["declare_queryable"],
        "key_exprs": ["user/login"]
      },
      {
        "id": "internal_liveliness_relay",
        "permission": "allow",
        "flows": ["ingress", "egress"],
        "messages": ["liveliness_token"],
        "key_exprs": ["mower/**"]
      },
    ],

    "subjects": [
      // An empty subject matches clients without Zenoh credentials. The
      // Firebase ID token is authenticated by the user/login handler.
      {
        "id": "guest_login_user"
      },
      {
        "id": "mtls_router_peer",
        "cert_common_names": ["Emi Mower Zenoh mTLS"]
      }
    ],

    "policies": [
      {
        "id": "guest_login_policy",
        "subjects": ["guest_login_user"],
        "rules": ["user_login_query"]
      },
      {
        "id": "internal_queryable_policy",
        "subjects": ["mtls_router_peer"],
        "rules": ["internal_queryable_declaration", "internal_liveliness_relay"]
      }
    ]
  }
}
